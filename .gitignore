# --- FABRİKA GÖRÜNTÜSÜ: hiçbir koşulda commit edilmez ---
data/real/
data/factory/
*.mp4
*.avi
*.mov
*.mkv

# --- Veri (üretilebilir veya indirilebilir → git'te yeri yok) ---
data/**
!data/**/
!data/**/.gitkeep
!data/README.md
!data/**/README.md

# İndirilen açık veri setlerinin kendi belgeleri bizim dokümanımız değildir;
# yukarıdaki README istisnası Windows'ta büyük/küçük harf ayırmadığı için
# setlerin `ReadMe.md` dosyalarını da içeri alıyordu. Değerlendirme notu
# docs/veri_setleri_degerlendirme.md dosyasında tutulur.
data/raw/**

# --- Model ağırlıkları ---
models/**
!models/.gitkeep
*.pt
*.pth
*.onnx
*.weights
*.h5

# --- Çıktılar (koşu sonuçları, figürler, metrikler) ---
outputs/**
!outputs/**/
!outputs/**/.gitkeep
runs/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# --- Editör / OS ---
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# --- Geçici ---
*.log
*.tmp
tmp/
scratch/

# --- Yerel bağlam dosyası ---
# Oturum başında yüklenen proje bağlamı. İçeriği rapor/kod deposunun kendi
# belgelerinde zaten var; depoda ikinci bir kopya olarak durmasına gerek yok.
PROJE_BAGLAM.md
CLAUDE.md

# --- Ekip demosu ---
# Kod (run_demo.py, uyusmazliklar/) depoda durur; GİRDİ ve ÇIKTI durmaz.
# Videolar fabrika/deneme çekimidir ve iki depo da PUBLIC — .gitignore tek
# korumadır. Ağırlık dosyaları da buraya sızmasın: 6 MB'lık .pt dosyaları
# depo geçmişini kalıcı şişirir ve `runs/` altında zaten üretiliyorlar.
demo/girdi/
demo/cikti/
demo/*.mp4
demo/*.pt
demo/*.zip
demo/*.ipynb
